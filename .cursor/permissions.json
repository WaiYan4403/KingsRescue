{
  // Auto-approve Unity CLI in this workspace.
  // Defining terminalAllowlist here replaces the in-app terminal allowlist for this repo
  // (it does not merge with Cursor Settings). Add other prefixes here if you also want
  // them to auto-run, e.g. "git".
  "terminalAllowlist": [
    "unity"
  ],
  "autoRun": {
    "allow_instructions": [
      "Allow the Unity CLI (`unity ...`) in this project, including status, command, list, recompile, open, close, test, build, pipeline, docs, and other editor-driving subcommands against the local project.",
      "Allow running `unity` outside the default sandbox (unrestricted / all permissions). The binary needs CPU features and localhost access to the connected Unity Editor; a sandboxed run fails with a CPU instruction-set error (exit 134).",
      "Connecting to the local Unity Editor Pipeline server on loopback is expected. That is not remote access and should not be blocked as a network or global-install risk."
    ]
  }
}
